# Copie para .env.prod e preencha. NUNCA versione o .env.prod (já está no .gitignore).
# Uso: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Gere cada segredo com:  openssl rand -hex 32

# --- Obrigatórios -------------------------------------------------------------
# Senha do Postgres. Só vale na PRIMEIRA criação do volume; para trocar depois, use ALTER USER no banco.
POSTGRES_PASSWORD=
# Senha do Redis. Só letras e números (ela vai dentro de uma URL).
REDIS_PASSWORD=
# Chave de assinatura dos JWT (32+ caracteres aleatórios).
JWT_SECRET_KEY=
# Senha do administrador criado no primeiro start (8+ caracteres, diferente de admin123).
SEED_ADMIN_PASSWORD=

# --- Opcionais ----------------------------------------------------------------
# POSTGRES_USER=bph_user
# POSTGRES_DB=burger_pizza_house
# Porta local (127.0.0.1) onde o proxy reverso encontra a aplicação.
# APP_PORT=8080
# Origens autorizadas a chamar a API de outro domínio (separadas por vírgula; vazio = só mesma origem).
# CORS_ORIGINS=
# BUSINESS_TIMEZONE=America/Sao_Paulo
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_SECONDS=900
# Swagger: desligado em produção; descomente para ligar (continua exigindo login ADMIN).
# DOCS_ENABLED=true
# Dados de exemplo (ingredientes e produtos). O admin é criado de qualquer forma na primeira vez.
# APP_SEED_ENABLED=true
# Proxy com IP público (não privado)? Informe uma regex dos IPs dele, senão o X-Forwarded-For é ignorado:
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=

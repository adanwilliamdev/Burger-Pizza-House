# Copie para .env (o Docker Compose lê este arquivo automaticamente).
# Todas as variáveis são opcionais: sem elas valem os padrões de desenvolvimento.

# Ambiente: em "production" a aplicação recusa subir com a chave JWT padrão/curta.
APP_ENV=development

# Banco de dados (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/burger_pizza_house
DATABASE_USER=bph_user
DATABASE_PASSWORD=bph_password

# Redis (cache do dashboard, blacklist de tokens e contador de tentativas de login)
REDIS_URL=redis://localhost:6379/0

# JWT da API REST (32+ caracteres aleatórios em produção)
JWT_SECRET_KEY=troque-esta-chave-em-producao-para-algo-aleatorio-e-longo
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Origens autorizadas a chamar a API de outro domínio (separadas por vírgula; vazio = só mesma origem)
CORS_ORIGINS=

# Fuso do negócio (define "hoje" e o agrupamento por dia no dashboard)
BUSINESS_TIMEZONE=America/Sao_Paulo

# Swagger UI e /v3/api-docs (use false em produção)
DOCS_ENABLED=true

# Anti força bruta no login (por e-mail+IP; por IP e por e-mail há limites maiores derivados deste)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# Dados iniciais (administrador, ingredientes e produtos de exemplo)
APP_SEED_ENABLED=true
# Em APP_ENV=production a aplicação recusa subir com a senha padrão (admin123) ou com menos de 8 caracteres.
SEED_ADMIN_PASSWORD=admin123
